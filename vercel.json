{
  "version": 2,
  "builds": [
    {
      "src": "server.ts",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.ts"
    },
    {
      "src": "/sitemap.xml",
      "dest": "server.ts"
    },
    {
      "src": "/jobs/load-booking-agent-hamilton/?",
      "status": 301,
      "headers": {
        "Location": "https://logistics.certusgroup.com/jobs/load-booking-agent-hamilton/"
      }
    },
